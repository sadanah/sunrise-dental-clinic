<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.sunrisedentalclinic.report.*" %>
<% String ctx = request.getContextPath(); %>
<!DOCTYPE html>
<html>
<head><title>Report Result</title></head>
<body>
<h1>Report Result</h1>
<%
    Report report = (Report) request.getAttribute("report");
%>
<p>Report ID: <%= report.getReportID() %></p>
<p>Generated By: <%= report.getGeneratedBy() %></p>
<p>Generated Date: <%= report.getGeneratedDate() %></p>

<%
    if (report instanceof RevenueReport) {
        RevenueReport rr = (RevenueReport) report;
%>
<h2>Total Revenue: <%= rr.getTotalRevenue() %></h2>
<%
    }
    // Add similar instanceof blocks for DailyAppointmentReport / DentistScheduleReport
    // once their result-holding fields/getters are finalized
%>
<a href="<%= ctx %>/admin-dashboard.jsp">Back to Dashboard</a>
</body>
</html>