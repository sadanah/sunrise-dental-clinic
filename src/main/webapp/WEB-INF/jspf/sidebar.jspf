<%@ page import="com.sunrisedentalclinic.domain.Session" %>
<%
    Session appSession = (Session) session.getAttribute("appSession");
    String role = (appSession != null) ? appSession.getRole() : null;
    String currentPage = (String) request.getAttribute("currentPage");

    String dashboardUrl;
    if ("ADMIN".equals(role)) {
        dashboardUrl = ctx + "/admin-dashboard.jsp";
    } else if ("DENTIST".equals(role)) {
        dashboardUrl = ctx + "/dentist-dashboard.jsp";
    } else {
        dashboardUrl = ctx + "/receptionist-dashboard.jsp";
    }
%>
<% if (appSession != null) { %>
<div class="sidebar">
    <div class="brand">Sunrise Dental</div>
    <a class="nav-item <%= "dashboard".equals(currentPage) ? "active" : "" %>" href="<%= dashboardUrl %>">Dashboard</a>
    <% if ("RECEPTIONIST".equals(role)) { %>
    <a class="nav-item <%= "appointments".equals(currentPage) ? "active" : "" %>" href="<%= ctx %>/register-appointment.jsp">Appointments</a>
    <a class="nav-item <%= "billing".equals(currentPage) ? "active" : "" %>" href="<%= ctx %>/generate-bill.jsp">Billing</a>
    <% } %>
    <% if ("ADMIN".equals(role)) { %>
    <a class="nav-item <%= "reports".equals(currentPage) ? "active" : "" %>" href="<%= ctx %>/admin/reports">Reports</a>
    <a class="nav-item <%= "manage-staff".equals(currentPage) ? "active" : "" %>" href="<%= ctx %>/admin/staff">Manage Staff</a>
    <a class="nav-item <%= "manage-treatment".equals(currentPage) ? "active" : "" %>" href="<%= ctx %>/admin/treatments">Manage Treatments</a>
    <% } %>
    <div class="nav-footer">
        <a class="nav-item" href="<%= ctx %>/help">Help</a>
        <a class="nav-item" href="<%= ctx %>/logout">Logout</a>
    </div>
</div>
<% } %>